{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/tasks",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/vault-index",
