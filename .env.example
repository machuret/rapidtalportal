NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
FIRECRAWL_API_KEY=fc-...
APIFY_API_TOKEN=
# Optional: change the no-cookie LinkedIn company-post Actor without a code deployment.
APIFY_LINKEDIN_ACTOR_ID=harvestapi~linkedin-company-posts
# Site-crawl dossier synthesis + Company DNA fill (same key as the edge functions use)
OPENROUTER_API_KEY=sk-or-...
# REQUIRED for the Access section: encrypts stored passwords (AES-256-GCM).
# Without it, Access is disabled — it refuses to store logins rather than save
# them unencrypted. /admin/health flags a missing key in red. Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Tasks cron (/api/cron/tasks): shared secret Vercel sends as a Bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional: archive "done" cards completed more than this many days ago (default 30)
TASK_ARCHIVE_DAYS=30
