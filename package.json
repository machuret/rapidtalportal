{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "styles:check": "node scripts/styles-guard.mjs",
    "styles:baseline": "node scripts/styles-guard.mjs --update",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e:roles": "playwright test e2e/content-studio-roles.spec.ts e2e/lead-generation-roles.spec.ts e2e/client-first-success.spec.ts e2e/client-discovery-coach.spec.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "db:status": "node scripts/apply-migrations.mjs --status",
    "db:baseline": "node scripts/apply-migrations.mjs --baseline",
    "db:apply": "node scripts/apply-migrations.mjs --apply",
    "functions:deploy": "node scripts/deploy-functions.mjs",
    "prospecting:actor-lab": "node scripts/prospecting-actor-lab.mjs",
    "gen:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/schema.generated.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
